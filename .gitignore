# Dependencies
node_modules/

# Build outputs
dist/
lib/
*.tsbuildinfo

# 例外：dsh-retry-gate 没有构建步骤，它的 lib/ 就是源码本身。
# 上面的 `lib/` 是为 tsdown 产物写的（见 dsh-media），不适用于纯 ESM 包。
!packages/dsh-retry-gate/lib/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# pnpm store
.pnpm-store/

# npm cache kept inside the workspace (the sandbox denies ~/.npm/_cacache)
.npm-cache/

# Local test media (not part of any package)
samples/
